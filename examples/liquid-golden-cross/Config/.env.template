# API credentials. Copy to Config/.env and fill in. Never commit the copy, never print a value.

# Data Curator: the key of the provider you use
KNDC_API_KEY_FMP=
KNDC_API_KEY_SHARADAR=
KNDC_API_KEY_LSEG=

# KaxaNuk engine licences: Backtest Engine (KNBE), Attribution Analysis (KNAA)
KNBE_API_KEY_KAXANUK=
KNAA_API_KEY_KAXANUK=

# The desk's index and factor files, read in place: the folder holding Benchmarks/ and
# Factors/. Empty means the drop zones under Data/Curator/. A path, not a secret.
KN_ANALYTICS_PATH=

# Paper trading, step 7: where Paper_Trading/daily_update.py reads its data and writes its
# record. INPUT is provider (download here) or database (read what another machine
# published). SINKS is local, database or local,database. DATABASE is a DuckDB file, or
# postgres:<connection string> for a PostgreSQL server; its password is a secret like the
# keys above. PUBLISH_DATA=true also writes the refreshed prices to the database.
PAPER_TRADING_INPUT=provider
PAPER_TRADING_SINKS=local
PAPER_TRADING_DATABASE=Paper_Trading/paper_trading.duckdb
PAPER_TRADING_PUBLISH_DATA=false
