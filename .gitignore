# --- Your library is yours ------------------------------------------------------------------------
# Sources are usually copyrighted files you may hold but not redistribute, and private notes are
# private. Both stay out of any push by default. Plain-text clippings you wrote yourself may be
# tracked; remove a pattern below if you want a kind of source in your own private clone.
Sources/**/*.pdf
Sources/**/*.epub
Sources/**/*.docx
Sources/**/*.pptx
Sources/**/*.xlsx
Sources/**/*.zip
Sources/**/*.png
Sources/**/*.jpg
Sources/**/*.jpeg
Philosophy/Private/*
!Philosophy/Private/.gitkeep

# --- The skills, and everything a tool might generate beside them -----------------------------------
# The skills are committed in the two directories that assistants actually read: `.claude/skills/`,
# which is the only one Claude Code looks in, and `.agents/skills/`, which Copilot, Cursor, Codex,
# Gemini, OpenCode and Windsurf read. Everything below is generated per machine — by `apm install`
# if this repository is ever given dependencies again — and stays out of git.
.cursor/
.codex/
.gemini/
.github/
.opencode/
.windsurf/
.grok/
.kiro/
.claude/commands/
.claude/rules/
.claude/settings.local.json

# Skills that came from installed dependencies are per-machine. Only the researcher's own eleven
# are committed — they are the repository.
.claude/skills/*
!.claude/skills/audit/
!.claude/skills/blueprint/
!.claude/skills/brainstorm/
!.claude/skills/compile/
!.claude/skills/note/
!.claude/skills/objective/
!.claude/skills/query/
!.claude/skills/refine/
!.claude/skills/refresh-index/
!.claude/skills/researcher-init/
!.claude/skills/teach/

.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/audit/
!.agents/skills/blueprint/
!.agents/skills/brainstorm/
!.agents/skills/compile/
!.agents/skills/note/
!.agents/skills/objective/
!.agents/skills/query/
!.agents/skills/refine/
!.agents/skills/refresh-index/
!.agents/skills/researcher-init/
!.agents/skills/teach/

# --- AI setup, managed by APM per machine ---------------------------------------------------------
apm_modules/
apm.lock.yaml
.mcp.json
build/
.claude-plugin/

# --- IDE and OS --------------------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
