# --- Your library is yours ------------------------------------------------------------------------
# Sources are usually copyrighted files you may hold but not redistribute, so they stay out of
# any push by default. Plain-text clippings you wrote yourself may be tracked; remove a pattern
# below if you want a kind of source in your own private clone.
Sources/**/*.pdf
Sources/**/*.epub
Sources/**/*.docx
Sources/**/*.pptx
Sources/**/*.xlsx
Sources/**/*.zip
Sources/**/*.png
Sources/**/*.jpg
Sources/**/*.jpeg

# --- The skills, and everything a tool might generate beside them -----------------------------------
# The skills are committed in the two directories that assistants actually read: `.claude/skills/`,
# which is the only one Claude Code looks in, and `.agents/skills/`, which Copilot, Cursor, Codex,
# Gemini, OpenCode and Windsurf read. Both are versioned whole — a new skill needs no line here.
# Everything else below is generated per machine and stays out of git.
.cursor/
.codex/
.gemini/
.github/
.opencode/
.windsurf/
.grok/
.kiro/
.claude/commands/
.claude/rules/
.claude/settings.local.json
.agents/*
!.agents/skills/

# --- Derived from the sources and the code: regenerable, never versioned --------------------------
# Extracts are the text the read skill's script pulls out of the PDFs, one file per chapter. They
# are the PDF's words, under the PDF's copyright, and they come back with one command.
Extracts/
__pycache__/
.venv/

# --- AI setup, managed by APM per machine ---------------------------------------------------------
apm_modules/
apm.lock.yaml
.mcp.json
build/
.claude-plugin/

# --- IDE and OS --------------------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
